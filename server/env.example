# Copy this file to .env and fill in your own values before running the server.

PORT=3000

# Both aviationweather.gov and api.weather.gov ask every client to identify
# itself with a real contact so they can reach you if something's wrong.
# Put your app name + an email you actually check. Do not skip this.
APP_USER_AGENT="Flyday (you@example.com)"

# Checklist thresholds. Every one of these can also be overridden per-request
# via a matching query param (see lib/checklist.js) - these are just the
# fallback if a request doesn't specify one. Defaults match the reference
# "Cessna 172 Good Flying Weather Checklist" bands.
DEFAULT_WIND_THRESHOLD_KT=10
DEFAULT_PRESSURE_THRESHOLD_HPA=1020
DEFAULT_PRESSURE_FALL_THRESHOLD_HPA3H=-3
DEFAULT_GRADIENT_THRESHOLD_HPA100KM=6
DEFAULT_GUST_SPREAD_YELLOW_KT=5
DEFAULT_GUST_SPREAD_RED_KT=10
DEFAULT_VISIBILITY_GREEN_SM=10
DEFAULT_VISIBILITY_YELLOW_SM=5
DEFAULT_CEILING_GREEN_FT=5000
DEFAULT_CEILING_YELLOW_FT=3000
DEFAULT_DEWPOINT_SPREAD_GREEN_C=8
DEFAULT_DEWPOINT_SPREAD_YELLOW_C=4
DEFAULT_PRECIP_YELLOW_PCT=20
DEFAULT_PRECIP_RED_PCT=50

# How long (minutes) to cache upstream responses per airport, to stay well
# under aviationweather.gov's 100 requests/minute limit and NWS's fair-use
# expectations.
CACHE_MINUTES=20
