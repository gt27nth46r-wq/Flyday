# Copy this file to .env and fill in your own values before running the server.

PORT=3000

# Both aviationweather.gov and api.weather.gov ask every client to identify
# itself with a real contact so they can reach you if something's wrong.
# Put your app name + an email you actually check. Do not skip this.
APP_USER_AGENT="Flyday (you@example.com)"

# Default go/no-go thresholds. Pilots can override these per-request from
# the UI, but these are what's used if none are supplied.
DEFAULT_WIND_THRESHOLD_KT=10
DEFAULT_PRESSURE_THRESHOLD_HPA=1020

# Ceiling/visibility act as a safety gate on top of the pressure+wind rule -
# a day can't be called GOOD below these, and drops to BAD below basic VFR
# minimums (1,000ft / 3sm) no matter what you set here.
DEFAULT_CEILING_THRESHOLD_FT=3000
DEFAULT_VISIBILITY_THRESHOLD_SM=5

# How long (minutes) to cache upstream responses per airport, to stay well
# under aviationweather.gov's 100 requests/minute limit and NWS's fair-use
# expectations.
CACHE_MINUTES=20
